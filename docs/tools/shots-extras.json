      "h": 700,
      "steps": [
        {
          "eval": "[...document.querySelectorAll('.sp-disk')].find(d => d.textContent.includes('LAB1629U1'))?.scrollIntoView({ block: 'center' })"
        }
      ]
    },
    {
      "name": "extras-write-test",
      "hash": "#/drives",
      "h": 760,
      "steps": [
        {
          "eval": "[...document.querySelectorAll('.sp-disk')].find(d => d.textContent.includes('LAB1259S2'))?.querySelector('[data-sp=\"disk-test\"]')?.click()"
        }
      ]
    },
    {
      "name": "extras-usb-eject",
